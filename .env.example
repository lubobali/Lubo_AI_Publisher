# --- Required -------------------------------------------------------------
# NVIDIA NIM (writer LLM + embeddings)
NVIDIA_API_KEY=
# NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VLM_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# PostgreSQL (Docker default)
DATABASE_URL=
POSTGRES_PASSWORD=
PUBLISHER_TZ=America/Chicago

# --- Optional -------------------------------------------------------------
# Fallback LLM if NIM fails
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Podcast transcription (biohacker / ai_news / tech_talk / market_pulse)
DEEPGRAM_API_KEY=

# LinkedIn publishing (token lasts 60 days, no refresh token)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_API_VERSION=

# X publishing (OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Langfuse tracing (off by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Nightly Backblaze B2 backups
B2_KEY_ID=
B2_APP_KEY=
B2_ENDPOINT=
B2_BUCKET=

# Read LuBot staging git/WakaTime from a local mount instead of SSH (prod worker)
STAGING_LOCAL=
